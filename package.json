{
  "name": "the-hollow-meridian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A first-person exploration puzzle game in the spirit of Myst, built with three.js.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:dist": "node tools/check-dist.mjs",
    "stamp": "node tools/stamp-release.mjs",
    "verify:live": "node tools/verify-live.mjs",
    "preview": "vite preview --port 4173",
    "smoke": "node tools/smoke.mjs",
    "audit": "node tools/audit.mjs",
    "audit:all": "node tools/audit.mjs --all",
    "walk": "node tools/walkcheck.mjs",
    "gaps": "node tools/gaps.mjs",
    "mechanisms": "node tools/mechanisms.mjs",
    "tour": "node tools/tour.mjs",
    "scans": "node tools/export-scans.mjs",
    "reader": "node tools/reader-shots.mjs",
    "bake": "blender --background --factory-startup --python tools/blender/materials.py"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
